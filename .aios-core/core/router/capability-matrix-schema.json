{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://synkra.ai/schemas/capability-matrix.json",
  "title": "AIOX Cortex LLM Capability Matrix",
  "description": "Schema for capability-matrix.yaml — versioned multi-model routing matrix. Semantic checks (task_routing pointing to an existing model or policy) live in matrix-loader.js.",
  "type": "object",
  "required": ["models", "routing_policies", "task_routing"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Matrix schema version."
    },
    "models": {
      "type": "object",
      "minProperties": 1,
      "description": "Model id → capability definition.",
      "additionalProperties": { "$ref": "#/definitions/model" }
    },
    "routing_policies": {
      "type": "object",
      "minProperties": 1,
      "description": "Policy name → definition. Referenced by task_routing via `policy:<name>`.",
      "additionalProperties": { "$ref": "#/definitions/policy" }
    },
    "default_policy": {
      "type": "string",
      "minLength": 1,
      "description": "Policy applied when a category maps to `policy:default`."
    },
    "task_routing": {
      "type": "object",
      "minProperties": 1,
      "description": "Task category → model id or `policy:<name>`.",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(policy:)?[a-z0-9][a-z0-9._-]*$"
      }
    }
  },
  "definitions": {
    "model": {
      "type": "object",
      "required": ["provider", "strengths", "cost_tier", "speed_tier"],
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "description": "Provider slug (anthropic, openai, xai, google, ...)."
        },
        "strengths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Non-empty list of capability tags used for matching."
        },
        "cost_tier": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "speed_tier": {
          "type": "string",
          "enum": ["fast", "medium", "slow"]
        },
        "notes": {
          "type": "string",
          "description": "Optional free-form note (pricing, provenance, caveats)."
        }
      }
    },
    "policy": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
